# ============================================================================
# NFE Manager — Configuracao
# Copie este arquivo para .env e preencha os valores necessarios.
# ============================================================================

# Nome da aplicacao
APP_NAME=NFE Manager

# Modo de depuracao (True para desenvolvimento, False para producao)
DEBUG=True

# Chave secreta para sessoes e criptografia (gere uma chave forte e unica)
SECRET_KEY=change-me-in-production-use-env-var

# Diretorio para armazenamento de certificados
CERT_DIR=./certs

# Ambiente SEFAZ: True = homologacao (testes), False = producao (validade juridica)
HOMOLOGACAO=False

# Unidade Federativa padrao para consultas
DEFAULT_UF=SP

# Timeout para requisicoes a SEFAZ (em segundos)
TIMEOUT=60

# ============================================================================
# Firebase / Firestore (opcional — necessario para sincronizacao na nuvem)
# Se nao preenchido, o sistema funcionara apenas localmente.
# ============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ============================================================================
# CORS (opcional)
# Origins permitidas para CORS (se vazio, sera usado apenas localhost)
# ============================================================================
ALLOWED_ORIGINS=
