APP_NAME=NFE Manager
# Para produção, Defina DEBUG=False e use uma SECRET_KEY forte e única
DEBUG=True
SECRET_KEY=change-me-in-production-use-env-var
CERT_DIR=./certs
HOMOLOGACAO=True
DEFAULT_UF=SP
TIMEOUT=60

# Variáveis de ambiente para Firebase (opcional, se não definidas o frontend usará fallback hardcoded)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Origins permitidas para CORS (se vazio, será usado apenas localhost em desenvolvimento)
ALLOWED_ORIGINS=
